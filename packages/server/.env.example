# Server
PORT=8788
CORS_ORIGIN=*

# Shared session cookie for zkaudit (another subdomain). Set on cipherpay-server only.
# Example: cp.appfounder.ca + zkaudit.appfounder.ca → use Domain=.appfounder.ca and Secure on HTTPS.
# CIPHERPAY_SESSION_COOKIE_DOMAIN=.appfounder.ca
# CIPHERPAY_SESSION_COOKIE_SECURE=true

# JWT
JWT_SECRET=dev-insecure-change-me

# Solana
SOLANA_RPC_URL=http://localhost:8899
PROGRAM_ID=AWVNBHaF1upXopq9dQpRpY54c9113bBskqiv16MUTDDd

